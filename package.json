{
  "name": "what-the-song",
  "version": "0.0.1",
  "private": true,
  "description": "A private Vietnamese guess-the-song game",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test && npm run test:ingest",
    "test:e2e": "turbo run test:e2e",
    "test:ingest": "python tools/test_ingest.py && python tools/test_validate_seed.py && python tools/test_ingest_food.py && python tools/test_validate_food_seed.py && python tools/test_ingest_people.py && python tools/test_validate_people_seed.py",
    "validate": "python tools/validate_seed.py seed.jsonl",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "turbo": "^2.11.5"
  },
  "engines": {
    "node": ">=22"
  }
}
