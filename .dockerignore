# Both images build from the repo root (docker/*.Dockerfile) and install their
# own dependencies from the pruned lockfile. Patterns need **/ to reach into
# apps/ and packages/ — .dockerignore matches from the context root only.

# Build artefacts and deps.
**/node_modules
**/.next
**/dist
**/.turbo
apps/web/out
**/*.tsbuildinfo

# The clip library is mounted at runtime, never copied into an image.
apps/web/public/assets
clips
seed.jsonl

# Secrets and local settings.
**/.env

# Not needed to build or serve.
.git
docs
tools
**/*.md
