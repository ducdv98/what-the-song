# Copy to .env for local development — ConfigModule loads it on boot.
# docker compose sets these itself; see ../docker-compose.yml.

PORT=4000
DATABASE_URL=postgres://wts:wts@127.0.0.1:5432/wts

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me

# Access token lifetime (seconds) and refresh token lifetime (days).
JWT_ACCESS_TTL=900
REFRESH_TTL_DAYS=30

# Whether a proxy you control sits in front: Caddy in production, and the Next
# dev server (which proxies /api) in development — hence true here. Turn it off
# only if the API is reachable directly, or clients could spoof their IP.
TRUST_PROXY=true
COOKIE_SECURE=false

# Sign-in / register attempts per minute per client.
AUTH_RATE_LIMIT=10

# Leaderboard weeks start Monday 00:00 and months on the 1st, at this many
# hours from UTC. 7 is Vietnam.
LEADERBOARD_UTC_OFFSET=7
