# Copy to .env — docker compose reads it automatically.
# This is the cross-platform way to set these: PowerShell cannot do the
# inline `VAR=value docker compose ...` form that bash uses.

# Port on the host.
PORT=3000

# Optional site-wide gate (basic auth), separate from player accounts. Leave
# both empty for a localhost-only game; set them before sharing the URL.
AUTH_USER=
AUTH_PASSWORD=

# ── Accounts (required) ──────────────────────────────────────────────────────

# Postgres password for the bundled database container.
POSTGRES_PASSWORD=

# Signs access tokens. Generate with: openssl rand -base64 48
# Changing it signs everyone out of their current access token (they are
# refreshed automatically), but does not touch accounts or records.
JWT_ACCESS_SECRET=

# true once the site is served over https (e.g. behind a TLS-terminating proxy).
COOKIE_SECURE=false

# Leaderboard weeks start Monday 00:00 and months on the 1st, at this many
# hours from UTC. 7 is Vietnam.
LEADERBOARD_UTC_OFFSET=7
