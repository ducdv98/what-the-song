{
  "name": "@wts/web",
  "version": "0.0.1",
  "private": true,
  "description": "The game: a Next.js static export",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/finalize-pwa.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "oxlint app/ lib/",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"lib/**/*.test.ts\" && vitest run app/components/FoodZoom.test.tsx app/HomePage.test.tsx app/components/MemePopup.test.tsx app/metadata.test.tsx"
  },
  "dependencies": {
    "@wts/contracts": "*",
    "@wts/core": "*",
    "@wts/topic-food": "*",
    "@wts/topic-songs": "*",
    "@wts/topics": "*",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.28",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
