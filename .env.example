# Copy to .env — docker compose reads it automatically.
# This is the cross-platform way to set these: PowerShell cannot do the
# inline `VAR=value docker compose ...` form that bash uses.

# Port on the host.
PORT=3000

# Leave both empty for a localhost-only game. Set them to put the site behind
# basic auth before sharing the URL with anyone.
AUTH_USER=
AUTH_PASSWORD=
