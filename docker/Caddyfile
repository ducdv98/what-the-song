{
	admin off
	auto_https off
	log {
		output stderr
		format console
	}
}

:80 {
	encode gzip zstd

	# Written by entrypoint.sh: a basic_auth block when AUTH_USER and
	# AUTH_PASSWORD are set, otherwise empty.
	import /etc/caddy/auth.caddy

	# Private game — ask crawlers to stay away. This backs up the noindex
	# metadata in app/layout.tsx; neither is access control, which is what
	# AUTH_USER/AUTH_PASSWORD are for.
	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Accounts and player records: the NestJS service. Caddy passes the
	# original Host through and sets X-Forwarded-For/-Proto, which the API
	# trusts (TRUST_PROXY) for rate limiting and Secure cookies.
	#
	# `dynamic a` re-resolves the service name, so after
	# `docker compose up -d --scale api=3` every replica gets traffic; a replica
	# that fails is skipped for a while (passive health checking).
	handle /api/* {
		reverse_proxy {
			dynamic a {
				name api
				port 4000
				refresh 10s
			}
			lb_policy round_robin
			lb_try_duration 5s
			fail_duration 30s
		}
	}

	# Assets live under /assets/<topic>/. A catalogue changes every time you
	# ingest more, so it must never be cached — otherwise new Subjects silently
	# fail to appear.
	@catalogue path /assets/*/catalogue.json
	handle @catalogue {
		root * /srv
		header Cache-Control "no-store"
		file_server
	}

	# Clips and covers have hashed filenames (a cover's is a hash of the image
	# itself), so both can cache indefinitely. Only the audio gets its type
	# forced; covers keep the image/jpeg that file_server infers.
	@assets path /assets/*
	handle @assets {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		@mp3 path *.mp3
		header @mp3 Content-Type "audio/mpeg"
		file_server
	}

	# Songs assets used to live under /clips; old URLs keep working.
	# Inside handle so it runs after the basic_auth gate, like everything else.
	@oldclips path_regexp oldclips ^/clips/(.*)$
	handle @oldclips {
		redir /assets/songs/{re.oldclips.1} permanent
	}

	# Keep the home redirect behind the same optional auth gate. Temporary (not
	# 308) and mirrors DEFAULT_TOPIC_ID: change both when a second Topic is playable.
	@home path /
	handle @home {
		redir /songs 302
	}

	# The exported app.
	handle {
		root * /srv/site
		try_files {path} {path}.html
		file_server
	}
}
